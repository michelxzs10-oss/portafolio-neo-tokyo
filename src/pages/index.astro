---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import { SITIO, CATEGORIAS } from '../config';

const destacados = (await getCollection('proyectos', ({ data }) => data.destacado && !data.borrador))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

// La primera palabra del nombre va en hueso y el resto en negro
const [primera, ...resto] = SITIO.nombre.split(' ');
const categorias = Object.values(CATEGORIAS);
const anio = new Date().getFullYear();
---

<Base>
  <!-- Bloque rojo de cartel -->
  <section class="bg-rojo text-blanco">
    <div class="mx-auto flex max-w-6xl flex-wrap items-stretch gap-10 px-6 pb-16 pt-12">
      <div class="min-w-0 flex-[999_1_26rem]">
        <p class="flex flex-wrap gap-x-5 text-sm font-bold uppercase tracking-[0.2em] text-vacio">
          <span>Neo Tokyo</span><span aria-hidden="true">//</span><span>Portafolio {anio}</span>
        </p>
        <h1 class="titular mt-6 break-words text-[clamp(4.5rem,15vw,13rem)] leading-[0.86]">
          <span class="block">{primera}</span>
          {resto.length > 0 && <span class="block text-vacio">{resto.join(' ')}</span>}
        </h1>
        <p class="mt-8 max-w-xl text-xl font-medium">{SITIO.rol}</p>
        <p class="mt-3 max-w-xl text-lg">{SITIO.descripcion}</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a
            href="/proyectos/"
            class="bg-vacio px-7 py-3.5 font-bold uppercase tracking-[0.1em] text-blanco shadow-[6px_6px_0_var(--color-blanco)] transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5"
          >
            Ver proyectos
          </a>
          <a
            href={`mailto:${SITIO.email}`}
            class="border-[3px] border-vacio px-7 py-3 font-bold uppercase tracking-[0.1em] text-blanco transition-colors hover:bg-vacio"
          >
            Contacto
          </a>
        </div>
      </div>

      <div class="hidden flex-[1_1_10rem] justify-end gap-5 md:flex" aria-hidden="true" lang="ja">
        <p class="kana text-[clamp(3.5rem,7vw,6.5rem)] leading-none text-vacio [writing-mode:vertical-rl]">ポートフォリオ</p>
        <p class="border-l-[3px] border-vacio pl-3 text-sm font-bold tracking-[0.3em] [writing-mode:vertical-rl]">
          ウェブ開発 ・ 電子工学 ・ ソフトウェア
        </p>
      </div>
    </div>
  </section>

  <!-- Franja ámbar con las categorías -->
  <div class="bg-naranja text-vacio">
    <ul class="mx-auto flex max-w-6xl flex-wrap justify-center gap-x-10 gap-y-1 px-6 py-3 font-display text-xl uppercase tracking-wide">
      {categorias.map((c) => <li>{c}</li>)}
    </ul>
  </div>

  <!-- Estelas de luz -->
  <div class="estelas" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

  <section class="mx-auto max-w-6xl px-6 pb-24 pt-14">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-2 border-b-[3px] border-blanco pb-4">
      <h2 class="titular text-5xl sm:text-7xl">Proyectos destacados</h2>
      <p class="kana text-2xl" lang="ja" aria-hidden="true">プロジェクト</p>
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-16 sm:grid-cols-2">
      {destacados.map((p, i) => <TarjetaProyecto proyecto={p} carga={i < 2 ? 'eager' : 'lazy'} />)}
    </div>

    <a
      href="/proyectos/"
      class="mt-14 inline-block font-bold uppercase tracking-[0.1em] text-cian underline decoration-2 underline-offset-8 hover:text-blanco"
    >
      Todos los proyectos →
    </a>
  </section>
</Base>

<style>
  .estelas {
    display: grid;
    gap: 14px;
    padding-top: 44px;
  }
  .estelas span {
    display: block;
    height: 5px;
    width: 72%;
    background: linear-gradient(to right, transparent, var(--color-cian) 70%, var(--color-blanco));
    box-shadow: 0 0 16px var(--color-cian);
  }
  .estelas span:nth-child(2) {
    height: 3px;
    width: 54%;
    margin-left: 12%;
    background: linear-gradient(to right, transparent, var(--color-naranja) 80%, var(--color-blanco));
    box-shadow: 0 0 12px var(--color-naranja);
  }
  .estelas span:nth-child(3) { height: 7px; width: 88%; }
  .estelas span:nth-child(4) { height: 3px; width: 40%; margin-left: 30%; }
</style>
