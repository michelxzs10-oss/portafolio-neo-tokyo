---
import type { CollectionEntry } from 'astro:content';
import Miniatura from './Miniatura.astro';
import { CATEGORIAS } from '../config';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  grande?: boolean;
  carga?: 'lazy' | 'eager';
}

const { proyecto, grande = false, carga = 'lazy' } = Astro.props;
const d = proyecto.data;
---

<article class:list={['tarjeta group relative', grande && 'grande sm:col-span-2']} data-categoria={d.categoria}>
  <Miniatura imagen={d.imagen} alt={d.imagenAlt} semilla={proyecto.id} etiqueta={CATEGORIAS[d.categoria]} carga={carga} />
  <div class="mt-5 flex items-baseline justify-between gap-4">
    <h3 class:list={['font-semibold text-blanco transition-colors group-hover:text-cian', grande ? 'text-2xl' : 'text-xl']}>
      <a href={`/proyectos/${proyecto.id}/`} class="after:absolute after:inset-0">{d.titulo}</a>
    </h3>
    <span class="shrink-0 text-sm tabular-nums text-tenue">{CATEGORIAS[d.categoria]}, {d.fecha.getFullYear()}</span>
  </div>
  <p class="mt-2 max-w-2xl leading-relaxed text-texto/85">{d.resumen}</p>
  {
    d.tecnologias.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tecnologías">
        {d.tecnologias.map((t) => (
          <li class="border border-cian-tenue px-2 py-0.5 text-xs text-tenue">{t}</li>
        ))}
      </ul>
    )
  }
</article>
