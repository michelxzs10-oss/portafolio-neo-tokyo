---
// Muestra la imagen del proyecto con un barrido de luz mientras carga.
// Si el proyecto no tiene imagen, dibuja un "plano" de la Grid con una estela única.
interface Props {
  imagen?: string;
  alt?: string;
  semilla: string;
  etiqueta: string;
  carga?: 'lazy' | 'eager';
}

const { imagen, alt = '', semilla, etiqueta, carga = 'lazy' } = Astro.props;

let h = 0;
for (const c of semilla) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const azar = (n: number) => {
  h = (Math.imul(h, 1103515245) + 12345) >>> 0;
  return h % n;
};

let x = -10;
let y = 60 + azar(130);
const partes = [`M${x} ${y}`];
while (x < 420) {
  x += 60 + azar(120);
  partes.push(`H${Math.min(x, 420)}`);
  if (x < 420) {
    y = 30 + azar(180);
    partes.push(`V${y}`);
  }
}
const trazo = partes.join(' ');
const idPatron = `rejilla-${semilla}`;
---

<div class:list={['miniatura', !imagen && 'sin-imagen']}>
  {
    imagen ? (
      <img src={imagen} alt={alt} loading={carga} decoding="async" onload="this.dataset.listo=''" />
    ) : (
      <svg viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" role="img" aria-label={alt || etiqueta}>
        <defs>
          <pattern id={idPatron} width="25" height="25" patternUnits="userSpaceOnUse">
            <path d="M25 0H0V25" fill="none" stroke="#0b4a57" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="400" height="250" fill="#03121a" />
        <rect width="400" height="250" fill={`url(#${idPatron})`} />
        <path d={trazo} fill="none" stroke="#ff7a1a" stroke-width="2.5" style="filter: drop-shadow(0 0 4px #ff7a1a)" />
        <text x="20" y="232" fill="#6b98a3" font-family="Exo 2, sans-serif" font-size="13">{etiqueta}</text>
      </svg>
    )
  }
</div>
